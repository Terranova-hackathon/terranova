PROJECT_NAME=

NODE_ENV=
API_PORT=

# Leave it empty to use the default Mock API url. 
API_URL=

# SQL Server 'sa' password: 8+ chars with upper, lower, digit and symbol.
SA_PASSWORD=

# Secret used to sign login tokens: at least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_KEY=

# Free key from https://rawg.io/apidocs
RAWG_API_KEY=

# Free key from https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=